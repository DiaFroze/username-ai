# ==============================================================================
# USERNAME AI — RAILWAY STAGING CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO GIT REPOSITORIES.
# In Railway, configure these under each service's "Variables" tab.
# Use Railway reference variable syntax: ${{ServiceName.VARIABLE_NAME}}

NODE_ENV=staging
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. API Service Variables (Railway Service: "api")
# ------------------------------------------------------------------------------
# Database Connection (Private Railway networking reference from Postgres service)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis Connection (Private Railway networking reference from Redis service)
REDIS_URL=${{Redis.REDIS_URL}}

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=staging-super-secret-jwt-key-minimum-32-chars-high-entropy!

# Internal Admin & Diagnostics Token (protects GET /health sensitive topology)
INTERNAL_ADMIN_TOKEN=staging-internal-admin-metrics-token-999

# Staging Notification Test Secret (for POST /api/v1/staging/test-notification)
STAGING_TEST_KEY=staging-test-secret-key-12345

# CORS Origins (Set to generated MiniApp domain once Railway creates it)
CORS_ALLOWED_ORIGINS=https://<miniapp-service>.up.railway.app,https://web.telegram.org

# Rate Limiting Policies
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CHECK_MAX=30
RATE_LIMIT_NAMING_MAX=10
RATE_LIMIT_DEFAULT_MAX=120

# AI Configuration (OpenAI primary, mock fallback if quota/network error)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_FALLBACK_PROVIDER=mock
AI_FALLBACK_MODEL=mock-fallback
AI_TIMEOUT_MS=8000
AI_CACHE_TTL_SECONDS=14400
OPENAI_API_KEY=sk-...

# Optional Keys (Falls back to HTML handle scraper if unset)
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 2. Telegram Bot Service Variables (Railway Service: "bot")
# ------------------------------------------------------------------------------
# Bot Token from @BotFather (dedicated staging bot, e.g. @UsernameAiStagingBot)
TELEGRAM_BOT_TOKEN=777777777:AAH_STAGING_BOT_TOKEN_CHANGE_ME_NOW

# Mini App URL pointing to Railway MiniApp public domain
TELEGRAM_MINIAPP_URL=https://<miniapp-service>.up.railway.app

# Internal API URL (Railway private networking DNS)
API_URL=http://api.railway.internal:3000

# ------------------------------------------------------------------------------
# 3. Mini App Service Variables (Railway Service: "miniapp")
# ------------------------------------------------------------------------------
# Build-time variable pointing to API public HTTPS domain
VITE_API_URL=https://<api-service>.up.railway.app
