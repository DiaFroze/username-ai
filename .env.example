# Application Environment Configuration
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/usernamedb

# Redis Cache
REDIS_URL=redis://localhost:6379

# Telegram Configuration
# Obtain token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# URL where the Mini App is served (e.g., http://localhost:5173 or your HTTPS tunnel)
TELEGRAM_MINIAPP_URL=http://localhost:5173

# Security
JWT_SECRET=super-secret-jwt-key-change-in-production

# External Platform Integrations (Optional)
YOUTUBE_API_KEY=

# AI Naming Engine Configuration (Phase 1C & 1D)
# AI_PROVIDER: 'mock' (offline development/testing) | 'openai' | 'gemini'
# Concrete model IDs must be configured by deployment operator (e.g. gpt-4o-mini, gemini-1.5-flash)
AI_PROVIDER=mock
AI_MODEL=
AI_FALLBACK_PROVIDER=mock
AI_FALLBACK_MODEL=
AI_TIMEOUT_MS=8000
AI_CACHE_TTL_SECONDS=14400

# AI Provider Credentials
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
